# ---- OpenAI (embeddings) ----
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small produces 1536-dimensional vectors.
EMBEDDING_DIMENSIONS=1536

# ---- Pinecone ----
# Ingestion writes to the index, so this key must have ReadWrite (or All) permissions.
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=lumora-hr-docs
PINECONE_NAMESPACE=hr-policies
# Used only when the index does not exist yet and has to be created (serverless).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# ---- Source documents & chunking ----
# Relative paths are resolved against the rag-ingestion project directory.
DOCS_DIR=../agent/docs/hr
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
