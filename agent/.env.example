# =========================== OpenAI ===========================
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5-mini
# Reasoning effort for gpt-5 family models: minimal | low | medium | high (leave empty for model default)
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =========================== Pinecone =========================
# Key used for all reads (semantic search).
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=lumora-hr-docs
PINECONE_NAMESPACE=hr-policies
# Optional: skip the index-name lookup by giving the index host directly.
PINECONE_INDEX_HOST=

# ---- Write access (controls whether the document-update tool exists) ----
# read      -> PINECONE_API_KEY is treated as read-only; the update tool is NOT available.
# readwrite -> PINECONE_API_KEY is also used for writes; the update tool is available.
PINECONE_ACCESS_MODE=read
# Optional separate key with ReadWrite permission. If set, it is used for writes and
# enables the update tool regardless of PINECONE_ACCESS_MODE.
PINECONE_WRITE_API_KEY=
# When true, the agent proves the write credential at startup by upserting and deleting a
# probe vector in a separate namespace. A read-only key is rejected by Pinecone (403) and the
# update tool is disabled. Fails closed: any probe error disables writes.
PINECONE_VERIFY_WRITE_ACCESS=true

# =========================== Documents ========================
# Relative paths are resolved against the agent project directory.
HR_DOCS_DIR=../docs/hr
COMPANY_PROFILE_PATH=../docs/company/company_profile.json
# Must match the ingestion project's settings so re-indexed documents are chunked identically.
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
AUDIT_LOG_PATH=./logs/document_updates.jsonl

# =========================== Agent ============================
RETRIEVAL_TOP_K=5
# How many times the agent may rewrite a query after retrieval is graded irrelevant.
MAX_QUERY_REWRITES=2
GRAPH_RECURSION_LIMIT=30
LOG_LEVEL=INFO
